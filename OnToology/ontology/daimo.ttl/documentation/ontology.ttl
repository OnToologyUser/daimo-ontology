#    Individuals
#################################################################

###  http://purl.org/pionera/daimo#
<http://purl.org/pionera/daimo#> rdf:type owl:NamedIndividual ;
                                 <http://purl.org/dc/terms/creator> :Edmundo ,
                                                                    :Jiayun .


###  http://purl.org/pionera/daimo#Edmundo
:Edmundo rdf:type owl:NamedIndividual ,
                  <http://xmlns.com/foaf/0.1/Person> ;
         <http://xmlns.com/foaf/0.1/mbox> <mailto:edmundo.mori.orrillo@upm.es> ;
         <http://xmlns.com/foaf/0.1/name> "Edmundo de Elvira Mori Orrillo" .


###  http://purl.org/pionera/daimo#Jiayun
