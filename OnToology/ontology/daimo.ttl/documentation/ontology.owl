<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.org/pionera/daimo#"
     xml:base="http://purl.org/pionera/daimo"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://purl.org/pionera/daimo#">
        <owl:versionIRI rdf:resource="http://purl.org/pionera/daimo/1.0.0"/>
        <terms:description xml:lang="en">DAIMO models AI models as governed assets in data spaces and connects publication metadata, policy constraints, invocation contracts, runtime requirements, execution traces, evaluation contexts, audit evidence, and reproducibility evidence.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-03</terms:issued>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-04</terms:modified>
        <terms:title xml:lang="en">DAIMO: An ontology for managing AI models in data spaces</terms:title>
        <vann:preferredNamespacePrefix>daimo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://purl.org/pionera/daimo#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Ontology for representing AI models as governed assets in data spaces.</rdfs:comment>
        <rdfs:label xml:lang="en">DAIMO ontology</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <mod:createdWith rdf:resource="https://chowlk.linkeddata.es/"/>
    </owl:Ontology>
    


